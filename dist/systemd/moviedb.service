[Unit]
Description=moviedb API
After=network-online.target
Wants=network-online.target

[Service]
# With Type=exec, `systemctl start` itself fails if the binary is missing or
# not executable (e.g. pct push without --perms), instead of the error only
# showing up later in the journal as a 203.
Type=exec
# A throwaway UID for each start. User= names it so moviedb-refresh.service
# gets the same UID when both run at once, which they need to share the
# StateDirectory. There must be no real `moviedb` user (userdel moviedb).
DynamicUser=true
User=moviedb
# Lives in /var/lib/private/moviedb with a symlink at /var/lib/moviedb, so
# DB_PATH doesn't change. systemd fixes ownership on every start.
StateDirectory=moviedb
EnvironmentFile=/etc/moviedb.env
ExecStart=/opt/moviedb/moviedb serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

# Hardening. The service only needs to write its own database directory.
# Check the score with: systemd-analyze security moviedb
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
# Fine for a static binary (these would break an interpreter like Python)
MemoryDenyWriteExecute=true
NoExecPaths=/
ExecPaths=/opt/moviedb/moviedb
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
KeyringMode=private
CapabilityBoundingSet=
UMask=0077
# The service needs very little, so cap it. A compromised process can't
# fork-bomb or eat the host's memory.
TasksMax=32
MemoryMax=256M
# Only allow binding the service port. This needs BPF delegation and may do
# nothing in an unprivileged LXC; check systemd-analyze security.
SocketBindDeny=any
SocketBindAllow=tcp:8000
# These tend to cause 226/NAMESPACE failures in unprivileged LXCs. Try them
# one at a time and drop any that stop the service starting.
#ProtectProc=invisible
#ProcSubset=pid
#PrivateUsers=true

[Install]
WantedBy=multi-user.target
