[Unit]
Description=Monthly moviedb OMDB refresh

[Timer]
OnCalendar=monthly
# Run on the next boot if the container was down when it was due
Persistent=true
# Spread the start out so it doesn't hit OMDB at midnight on the 1st with
# everyone else's cron jobs
RandomizedDelaySec=6h

[Install]
WantedBy=timers.target
